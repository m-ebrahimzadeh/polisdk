{
  "name": "@polisdk/poliauth-chrome",
  "version": "2.0.0",
  "description": "Chrome Extension MV3 storage and tab/content-script page driver adapters for @polisdk/poliauth",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@polisdk/poliauth": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "license": "MIT"
}
